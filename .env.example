# Copy via: node deploy/scripts/init-dev.mjs
# Private provider keys belong in .env, never in browser/Android settings.
NODE_ENV=development
APP_ORIGIN=http://localhost:8080
WEB_BIND=127.0.0.1
WEB_PORT=8080
MONGO_ROOT_PASSWORD=GENERATE_LOCAL_SECRET
MONGO_APP_PASSWORD=GENERATE_LOCAL_SECRET
MONGO_REPLICA_KEY=GENERATE_LOCAL_SECRET
REDIS_PASSWORD=GENERATE_LOCAL_SECRET
AUTH_SECRET=GENERATE_LOCAL_SECRET
MAIL_ENCRYPTION_KEY=GENERATE_LOCAL_SECRET
BACKUP_ENCRYPTION_KEY=GENERATE_LOCAL_SECRET
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_VOICE_MODEL=gpt-6-luna
SARVAM_API_KEY=
SARVAM_PRIVACY_CONFIRMED=true
SARVAM_SPEAKER=simran_en_customer
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Victor <noreply@localhost.test>
DAILY_CHAT_LIMIT=20
DAILY_EMAIL_LIMIT=500
DAILY_VOICE_SECONDS=300
MONTHLY_AI_LIMIT_CENTS=5000
CHAT_RESERVE_CENTS=5
VOICE_RESERVE_CENTS_PER_MINUTE=4
TTS_RESERVE_CENTS_PER_1000_CHARS=2
